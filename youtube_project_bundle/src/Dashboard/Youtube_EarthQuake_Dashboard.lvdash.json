{
  "datasets": [
    {
      "name": "dac9740b",
      "displayName": "EarthQuake_Detail",
      "queryLines": [
        "select * from earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "silver"
    },
    {
      "name": "be0cb62d",
      "displayName": "Magnitude_Type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket, magnitude_bucket from\r\n",
        "(select CASE \r\n",
        " WHEN mag < 2 then 'Micro (<2)'\r\n",
        " WHEN mag BETWEEN 2 AND 3 then 'Minor (2-3)'\r\n",
        " WHEN mag BETWEEN 3 AND 4 then 'Light (3-4)'\r\n",
        " else\r\n",
        "'Moderate (4+)' End as magnitude_bucket\r\n",
        "from earthquake_data)\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "youtube_dev",
      "schema": "silver"
    },
    {
      "name": "7093546d",
      "displayName": "EarthQuake_Country",
      "queryLines": [
        "select count(*) as event_count,\r\n",
        "CASE \r\n",
        "  WHEN size(split(place,', ')) = 1 then split(place,', ')[0] \r\n",
        "  ELSE split(place,', ')[1] \r\n",
        "END as country\r\n",
        "FROM (\r\n",
        "    SELECT time,title,mag,longitude,place,latitude from \r\n",
        "    silver.earthquake_data_final\r\n",
        ")\r\n",
        "GROUP by country"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
